.page-city-picker{background:var(--bg-color,#f5f7fa);display:flex;flex-direction:column;height:100vh}.search-bar{background:#fff;border-bottom:2rpx solid #eee;flex-shrink:0;padding:16rpx 24rpx}.search-input-wrap{align-items:center;background:#f5f5f5;border-radius:40rpx;display:flex;height:72rpx;padding:0 24rpx}.search-icon{color:#999;font-size:28rpx;margin-right:12rpx}.search-input{color:#333;flex:1;font-size:28rpx;height:72rpx;line-height:72rpx}.clear-btn{color:#999;font-size:28rpx;padding:0 8rpx}.city-body{flex:1;overflow:hidden;position:relative}.city-scroll{background:#fff;flex:1;height:100%}.city-scroll.search-mode{background:#fff}.hot-section{background:#fff;padding:32rpx 32rpx 16rpx}.section-title{color:#999;display:block;font-size:26rpx;margin-bottom:24rpx}.hot-grid{display:flex;flex-wrap:wrap;gap:16rpx}.hot-chip{background:#f5f5f5;border-radius:12rpx;color:#333;font-size:28rpx;min-width:112rpx;padding:16rpx 32rpx;text-align:center}.hot-chip:active{background:#e8e8e8}.letter-section{background:#fff}.letter-header{background:#f5f7fa;border-top:2rpx solid #eee;padding:12rpx 32rpx}.letter-text{color:#999;font-size:24rpx;font-weight:600}.city-item{align-items:center;background:#fff;border-bottom:2rpx solid #f0f0f0;display:flex;justify-content:space-between;padding:28rpx 32rpx}.city-item:active{background:#f9f9f9}.city-name{color:#333;font-size:30rpx}.city-arrow{color:#ccc;font-size:32rpx}.index-bar{align-items:center;background:hsla(0,0%,100%,.8);border-radius:24rpx;display:flex;flex-direction:column;padding:8rpx 4rpx;position:absolute;right:4rpx;top:50%;transform:translateY(-50%);z-index:10}.index-letter{color:#666;font-size:20rpx;font-weight:600;height:36rpx;line-height:36rpx;text-align:center;width:36rpx}.index-letter.active{background:rgba(255,106,0,.15);border-radius:50%;color:var(--primary-color,#ff6a00)}.letter-overlay{align-items:center;background:rgba(0,0,0,.6);border-radius:24rpx;color:#fff;display:flex;font-size:64rpx;font-weight:700;height:128rpx;justify-content:center;left:50%;pointer-events:none;position:absolute;top:50%;transform:translate(-50%,-50%);width:128rpx;z-index:20}.empty-tip{align-items:center;display:flex;flex-direction:column;justify-content:center;padding:160rpx 64rpx;text-align:center}.empty-icon{font-size:96rpx;margin-bottom:24rpx}.empty-text{color:#999;font-size:28rpx}