@charset "UTF-8";
.page-city-picker {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-color, #f5f7fa);
}

/* ============ 顶部搜索栏 ============ */
.search-bar {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 2rpx solid #eee;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-icon {
  font-size: 28rpx;
  color: #999;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 72rpx;
  line-height: 72rpx;
}

.clear-btn {
  font-size: 28rpx;
  color: #999;
  padding: 0 8rpx;
}

/* ============ 主体 ============ */
.city-body {
  flex: 1;
  position: relative;
  overflow: hidden;
}

.city-scroll {
  flex: 1;
  height: 100%;
  background: #fff;
}

.city-scroll.search-mode {
  background: #fff;
}

/* ============ 热门城市 ============ */
.hot-section {
  padding: 32rpx 32rpx 16rpx;
  background: #fff;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 24rpx;
  display: block;
}

.hot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hot-chip {
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  min-width: 112rpx;
  text-align: center;
}

.hot-chip:active {
  background: #e8e8e8;
}

/* ============ A-Z 分组列表 ============ */
.letter-section {
  background: #fff;
}

.letter-header {
  padding: 12rpx 32rpx;
  background: #f5f7fa;
  border-top: 2rpx solid #eee;
}

.letter-text {
  font-size: 24rpx;
  color: #999;
  font-weight: 600;
}

.city-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #f0f0f0;
  background: #fff;
}

.city-item:active {
  background: #f9f9f9;
}

.city-name {
  font-size: 30rpx;
  color: #333;
}

.city-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* ============ 右侧 A-Z 索引条 ============ */
.index-bar {
  position: absolute;
  right: 4rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 4rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  z-index: 10;
}

.index-letter {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 20rpx;
  color: #666;
  font-weight: 600;
}

.index-letter.active {
  color: var(--primary-color, #ff6a00);
  background: rgba(255, 106, 0, 0.15);
  border-radius: 50%;
}

/* ============ 字母浮层 ============ */
.letter-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 128rpx;
  height: 128rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #fff;
  font-weight: 700;
  z-index: 20;
  pointer-events: none;
}

/* ============ 空状态 ============ */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 64rpx;
  text-align: center;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
