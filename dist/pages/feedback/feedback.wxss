.page-feedback {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 80rpx;
}

.page-header {
  padding: 32rpx;
  background: var(--white);
  border-bottom: 2rpx solid var(--border-color);
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-color);
}

.feedback-card {
  background: var(--white);
  margin: 24rpx;
  border-radius: var(--radius);
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.feedback-title {
  margin-bottom: 24rpx;
}

.title-text {
  font-size: 30rpx;
  color: var(--text-color);
  font-weight: 500;
  line-height: 1.6;
}

.cooldown-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--danger-color);
  line-height: 1.5;
}

.feedback-textarea {
  width: 100%;
  height: 320rpx;
  padding: 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  font-size: 28rpx;
  background: var(--bg-color);
  box-sizing: border-box;
  line-height: 1.6;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-color-hint);
  margin-top: 8rpx;
  display: block;
}

.submit-area {
  padding: 24rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty {
  text-align: center;
  padding: 160rpx 0;
  color: var(--text-color-hint);
}
