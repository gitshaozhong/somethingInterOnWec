.page-feedback{background:var(--bg-color);min-height:100vh;padding-bottom:80rpx}.page-header{background:var(--white);border-bottom:2rpx solid var(--border-color);padding:32rpx}.page-title{color:var(--text-color);font-size:36rpx;font-weight:700}.feedback-card{background:var(--white);border-radius:var(--radius);box-shadow:0 2rpx 8rpx rgba(0,0,0,.06);margin:24rpx;padding:32rpx}.feedback-title{margin-bottom:24rpx}.title-text{color:var(--text-color);font-size:30rpx;font-weight:500;line-height:1.6}.cooldown-hint{color:var(--danger-color);display:block;font-size:24rpx;line-height:1.5;margin-top:12rpx}.feedback-textarea{background:var(--bg-color);border:2rpx solid var(--border-color);border-radius:16rpx;box-sizing:border-box;font-size:28rpx;height:320rpx;line-height:1.6;padding:24rpx;width:100%}.char-count{color:var(--text-color-hint);display:block;font-size:22rpx;margin-top:8rpx;text-align:right}.submit-area{padding:24rpx}.submit-btn{align-items:center;background:var(--primary-color);border:none;border-radius:44rpx;color:#fff;display:flex;font-size:32rpx;font-weight:600;height:88rpx;justify-content:center;width:100%}.empty{color:var(--text-color-hint);padding:160rpx 0;text-align:center}