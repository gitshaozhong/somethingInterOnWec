@charset "UTF-8";
.page-publish {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: background 0.3s ease;
}

/* 学员发布：绿色渐变背景 */
.page-publish.tab-student {
  background: linear-gradient(180deg, #94F29A 0%, #C2F2C8 60%, #f5f7fa 100%);
}

/* 陪练员发布：蓝色渐变背景 */
.page-publish.tab-coach {
  background: linear-gradient(180deg, #58AFF6 0%, #9DD0FA 60%, #f5f7fa 100%);
  box-sizing: border-box;
}

/* 未登录空状态 */
.login-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 240rpx 64rpx;
}
.login-empty .login-empty-icon {
  font-size: 128rpx;
  margin-bottom: 32rpx;
}
.login-empty .login-empty-text {
  font-size: 28rpx;
  color: var(--text-color-hint);
  margin-bottom: 48rpx;
}

.login-btn {
  background: var(--primary-gradient);
  color: var(--white);
  border: none;
  border-radius: 48rpx;
  padding: 20rpx 80rpx;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(255, 106, 0, 0.3);
}

/* ============ 顶部渐变背景区 ============ */
.publish-header {
  padding: 24rpx 24rpx 0;
  flex-shrink: 0;
}

/* ============ 下沉式双 Tab ============ */
.publish-tab-bar {
  display: flex;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 24rpx 24rpx 0 0;
  padding: 6rpx;
  gap: 4rpx;
}

.publish-tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #5a6a7a;
  border-radius: 20rpx 20rpx 0 0;
  transition: all 0.2s;
}

.publish-tab-item.active {
  background: var(--white);
  color: #07B6D5;
  font-weight: 600;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.publish-tab-item.disabled {
  color: #b0b8c0;
  opacity: 0.5;
}

/* ============ 两身份都未注册：完善信息引导 ============ */
.empty-identity {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 64rpx;
  text-align: center;
}

.empty-icon {
  font-size: 112rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-color-hint);
  line-height: 1.5;
  margin-bottom: 48rpx;
}

.go-profile-btn {
  padding: 24rpx 64rpx;
  border-radius: 48rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

/* ============ 表单滚动区 ============ */
.form-scroll {
  flex: 1;
  height: 0;
  overflow-y: auto;
  background: var(--bg-color);
  padding-bottom: 32rpx;
}

.form-card {
  margin: 24rpx;
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--card-shadow);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
  padding: 8rpx 0 24rpx;
  border-bottom: 2rpx solid var(--border-color);
  margin-bottom: 32rpx;
}

/* ============ 表单项 ============ */
.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-color);
  display: block;
  margin-bottom: 12rpx;
}

.form-hint {
  font-size: 22rpx;
  color: var(--text-color-hint);
  display: block;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  font-size: 28rpx;
  background: var(--white);
  box-sizing: border-box;
}

.picker-value {
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  background: var(--white);
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-color);
}

.picker-value .placeholder {
  color: var(--text-color-hint);
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  font-size: 28rpx;
  background: var(--white);
  box-sizing: border-box;
  line-height: 1.5;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-color-hint);
  margin-top: 8rpx;
  display: block;
}

/* ============ 链接文字 ============ */
.link-text {
  font-size: 24rpx;
  color: var(--primary-color);
  margin-top: 12rpx;
  display: inline-block;
}

/* ============ 球馆选择入口卡片 ============ */
.venue-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
  border: 2rpx solid var(--border-color);
}

.venue-entry-placeholder {
  font-size: 28rpx;
  color: var(--text-color-hint);
}

.venue-entry-selected {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.venue-entry-name {
  font-size: 30rpx;
  color: var(--text-color);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.venue-entry-addr {
  font-size: 24rpx;
  color: var(--text-color-hint);
}

.venue-entry-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 40rpx;
  color: var(--text-color-hint);
  line-height: 1;
}

/* ============ 单选 Chip 行 ============ */
.radio-row {
  display: flex;
  gap: 16rpx;
}

.radio-chip {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--bg-color);
  color: var(--text-color-secondary);
  font-size: 28rpx;
  border: 2rpx solid var(--border-color);
}

.radio-chip.active {
  background: var(--primary-color-light);
  color: var(--primary-color);
  border-color: var(--primary-color);
  font-weight: 600;
}

/* ============ 价位预设 ============ */
.price-preset-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.price-preset-chip {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: var(--bg-color);
  color: var(--text-color-secondary);
  font-size: 24rpx;
  border: 2rpx solid var(--border-color);
}

.price-preset-chip.active {
  background: var(--primary-color-light);
  color: var(--primary-color);
  border-color: var(--primary-color);
  font-weight: 600;
}

.dual-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dual-input-row .form-input {
  flex: 1;
}

.dash {
  color: var(--text-color-hint);
  font-size: 28rpx;
  flex-shrink: 0;
}

/* ============ 底部提交按钮 ============ */
.submit-area {
  padding: 24rpx;
  flex-shrink: 0;
  background: var(--white);
  border-top: 2rpx solid var(--border-color);
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--primary-gradient);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 106, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}
