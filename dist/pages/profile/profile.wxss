@charset "UTF-8";
.page-profile {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 160rpx;
}

/* 未登录状态页面背景 */
.page-profile-loggedout {
  min-height: 100vh;
  background: linear-gradient(180deg, #AEECEB 0%, #F8D2E1 100%);
}

/* 未登录空状态 */
.login-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 240rpx 64rpx;
}
.login-empty .login-empty-icon {
  font-size: 128rpx;
  margin-bottom: 32rpx;
}
.login-empty .login-empty-text {
  font-size: 28rpx;
  color: var(--text-color-hint);
  margin-bottom: 48rpx;
}

.login-btn {
  background: var(--primary-gradient);
  color: var(--white);
  border: none;
  border-radius: 48rpx;
  padding: 20rpx 80rpx;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(255, 106, 0, 0.3);
}

/* 顶部用户信息区（青绿渐变背景） */
/* header 从导航栏下方开始，青色渐变不再透到导航栏 */
.header {
  background: linear-gradient(180deg, #07B6D5 0%, #4FC9E0 60%, var(--bg-color) 100%);
  padding: 32rpx 40rpx 120rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin-right: 32rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--white);
}

.user-details {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--white);
  margin-bottom: 8rpx;
}

.phone {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.setting-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.setting-arrow {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1;
}

/* 双数据卡片 */
.balance-cards {
  display: flex;
  gap: 24rpx;
}

.balance-card {
  flex: 1;
  height: 152rpx;
  border-radius: 32rpx;
  position: relative;
  overflow: hidden;
  box-shadow: var(--card-shadow);
}
.balance-card.orange {
  background: var(--primary-gradient);
}
.balance-card.green {
  background: var(--success-gradient);
}

.card-content {
  padding: 28rpx 32rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  box-sizing: border-box;
}

.amount {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--white);
  margin-bottom: 8rpx;
}

.label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.view-btn {
  position: absolute;
  top: 28rpx;
  right: 32rpx;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.view-arrow {
  font-size: 36rpx;
  color: var(--white);
  line-height: 1;
}

/* 订单管理网格 */
.order-section {
  background: var(--white);
  border-radius: 32rpx;
  margin: -64rpx 24rpx 24rpx;
  padding: 32rpx;
  box-shadow: var(--card-shadow);
  position: relative;
  z-index: 2;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 32rpx;
}

.order-grid {
  display: flex;
  justify-content: space-between;
}

.order-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 8rpx;
}
.order-item:active {
  opacity: 0.7;
}

.order-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
  background: var(--bg-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.order-text {
  font-size: 24rpx;
  color: var(--text-color-secondary);
  text-align: center;
}

/* 菜单分组容器 */
.menu-section {
  background: var(--white);
  border-radius: 32rpx;
  margin: 24rpx;
  padding: 0 32rpx;
  box-shadow: var(--card-shadow);
}

.menu-item {
  height: 112rpx;
  display: flex;
  align-items: center;
}
.menu-item:active {
  background: var(--bg-color);
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.menu-icon-wrap.orange {
  background: var(--primary-color-light);
}
.menu-icon-wrap.green {
  background: #e6f9f1;
}
.menu-icon-wrap.gray {
  background: var(--bg-color);
}

.menu-icon {
  font-size: 36rpx;
  line-height: 1;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-color);
}

.menu-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}
.menu-status.done {
  background: var(--primary-color-light);
  color: var(--primary-color);
}
.menu-status.pending {
  background: #fff2f0;
  color: var(--danger-color);
}

.menu-arrow {
  color: var(--text-color-hint);
  font-size: 36rpx;
  line-height: 1;
}

.menu-divider {
  height: 2rpx;
  background: var(--divider-color);
  margin: 0 8rpx;
}

/* 退出登录 */
.logout-section {
  padding: 40rpx 24rpx;
}

.logout-btn {
  text-align: center;
  background: var(--white);
  color: var(--danger-color);
  border: none;
  border-radius: 24rpx;
  padding: 24rpx;
  font-size: 30rpx;
  box-shadow: var(--card-shadow);
}
