.page-profile{padding-bottom:40rpx}.empty{color:var(--text-color-hint);padding:160rpx 0;text-align:center}.login-btn{background:var(--primary-color);border:none;border-radius:var(--radius);color:var(--white);margin-top:32rpx;padding:20rpx 64rpx}.header{background:var(--white);margin-bottom:24rpx;padding:64rpx 40rpx;text-align:center}.avatar{border-radius:50%;height:144rpx;margin:0 auto 24rpx;overflow:hidden;width:144rpx}.avatar-img{height:100%;width:100%}.avatar-placeholder{align-items:center;background:var(--primary-color-light);color:var(--primary-color);display:flex;font-size:56rpx;height:100%;justify-content:center;width:100%}.nickname{display:block;font-size:36rpx;font-weight:600}.role{color:var(--text-color-hint);display:block;font-size:26rpx;margin-top:8rpx}.menu{background:var(--white);margin-bottom:24rpx}.menu-item{align-items:center;border-bottom:2rpx solid var(--border-color);display:flex;padding:32rpx 40rpx}.menu-item:last-child{border-bottom:none}.menu-icon{font-size:36rpx;margin-right:24rpx}.menu-label{flex:1;font-size:30rpx}.menu-arrow{color:var(--text-color-hint);font-size:28rpx}.logout-section{padding:40rpx}.logout-btn{background:var(--white);border:none;border-radius:var(--radius);color:var(--danger-color);font-size:30rpx;padding:24rpx;text-align:center}