.page-orders{background:var(--bg-color);display:flex;flex-direction:column;height:100vh}.tab-scroll{background:var(--white);border-bottom:2rpx solid var(--border-color);display:flex;gap:16rpx;padding:20rpx 32rpx}.tab-chip{background:var(--bg-color);border-radius:40rpx;color:var(--text-color-secondary);flex-shrink:0;font-size:26rpx;padding:12rpx 32rpx}.tab-chip.active{background:var(--primary-color);color:var(--white)}.list-scroll{flex:1;padding:24rpx}.order-card{background:var(--white);border-radius:var(--radius);box-shadow:0 2rpx 6rpx rgba(0,0,0,.05);margin-bottom:20rpx;padding:28rpx 32rpx}.order-header{align-items:flex-start;display:flex;justify-content:space-between;margin-bottom:20rpx}.order-user-info{align-items:center;display:flex;gap:20rpx}.order-avatar{background-position:50%;background-size:cover;border-radius:50%;height:80rpx;width:80rpx}.order-avatar-placeholder{align-items:center;background:var(--primary-color-light);color:var(--primary-color);display:flex;font-size:32rpx;justify-content:center}.order-peer-name{display:block;font-size:30rpx;font-weight:600}.order-role-tag{color:var(--text-color-hint);font-size:22rpx}.order-no-text{color:var(--text-color-hint);font-family:monospace;font-size:22rpx}.order-body{margin-bottom:16rpx}.order-info-row{display:flex;margin-bottom:6rpx}.order-info-label{color:var(--text-color-hint);flex-shrink:0;font-size:24rpx;width:72rpx}.order-info-value{color:var(--text-color);font-size:26rpx}.order-checkin{margin-bottom:12rpx}.checkin-badge{border-radius:8rpx;font-size:22rpx;padding:4rpx 16rpx}.checkin-badge.valid{background:#f6ffed;color:var(--success-color)}.checkin-badge.invalid{background:#fff2f0;color:var(--danger-color)}.order-review-status{display:flex;gap:16rpx}.review-tag{background:#fffbe6;border-radius:8rpx;color:var(--warning-color);font-size:22rpx;padding:4rpx 16rpx}