.page-orders {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-color);
}

.tab-scroll {
  display: flex;
  background: var(--white);
  padding: 20rpx 32rpx;
  border-bottom: 2rpx solid var(--border-color);
  gap: 16rpx;
}

.tab-chip {
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  background: var(--bg-color);
  font-size: 26rpx;
  color: var(--text-color-secondary);
  flex-shrink: 0;
}

.tab-chip.active {
  background: var(--primary-color);
  color: var(--white);
}

.list-scroll {
  flex: 1;
  padding: 24rpx;
}

.order-card {
  background: var(--white);
  border-radius: var(--radius);
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.order-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.order-user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.order-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-size: cover;
  background-position: center;
}

.order-avatar-placeholder {
  background: var(--primary-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--primary-color);
}

.order-peer-name {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}

.order-role-tag {
  font-size: 22rpx;
  color: var(--text-color-hint);
}

.order-no-text {
  font-size: 22rpx;
  color: var(--text-color-hint);
  font-family: monospace;
}

.order-body {
  margin-bottom: 16rpx;
}

.order-info-row {
  display: flex;
  margin-bottom: 6rpx;
}

.order-info-label {
  width: 72rpx;
  font-size: 24rpx;
  color: var(--text-color-hint);
  flex-shrink: 0;
}

.order-info-value {
  font-size: 26rpx;
  color: var(--text-color);
}

.order-checkin {
  margin-bottom: 12rpx;
}

.checkin-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.checkin-badge.valid {
  color: var(--success-color);
  background: #f6ffed;
}

.checkin-badge.invalid {
  color: var(--danger-color);
  background: #fff2f0;
}

.order-review-status {
  display: flex;
  gap: 16rpx;
}

.review-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  color: var(--warning-color);
  background: #fffbe6;
}
