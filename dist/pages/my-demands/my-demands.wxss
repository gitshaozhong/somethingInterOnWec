.page-my-demands {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--bg-color);
}

.page-header {
  padding: 32rpx;
  background: var(--white);
  border-bottom: 2rpx solid var(--border-color);
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-color);
}

.list-scroll {
  flex: 1;
  padding: 24rpx;
}

.card {
  background: var(--white);
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-date {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.status-badge {
  font-size: 24rpx;
  padding: 4rpx 20rpx;
  border-radius: 8rpx;
}

.status-open {
  color: var(--success-color);
  background: #f6ffed;
}

.status-closed,
.status-expired {
  color: var(--text-color-hint);
  background: #f5f5f5;
}

.card-body {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  margin-bottom: 12rpx;
}

.info-label {
  width: 80rpx;
  font-size: 26rpx;
  color: var(--text-color-hint);
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: var(--text-color);
  flex: 1;
  word-break: break-all;
}

.budget-value {
  color: var(--primary-color);
  font-weight: 600;
}

.note-text {
  color: var(--text-color-secondary);
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--border-color);
}

.close-btn {
  padding: 12rpx 32rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  background: var(--bg-color);
  color: var(--text-color-secondary);
  border: 2rpx solid var(--border-color);
}

.close-btn.loading {
  opacity: 0.6;
}

.list-bottom {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: var(--text-color-hint);
}
