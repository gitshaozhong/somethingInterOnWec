.page-my-demands{background:var(--bg-color);display:flex;flex-direction:column;min-height:100vh}.page-header{background:var(--white);border-bottom:2rpx solid var(--border-color);padding:32rpx}.page-title{color:var(--text-color);font-size:36rpx;font-weight:700}.list-scroll{flex:1;padding:24rpx}.card{background:var(--white);border-radius:var(--radius);box-shadow:0 2rpx 8rpx rgba(0,0,0,.06);margin-bottom:24rpx;padding:32rpx}.card-header{align-items:center;display:flex;justify-content:space-between;margin-bottom:24rpx}.card-date{color:var(--text-color);font-size:32rpx;font-weight:600}.status-badge{border-radius:8rpx;font-size:24rpx;padding:4rpx 20rpx}.status-open{background:#f6ffed;color:var(--success-color)}.status-closed,.status-expired{background:#f5f5f5;color:var(--text-color-hint)}.card-body{margin-bottom:20rpx}.info-row{display:flex;margin-bottom:12rpx}.info-label{color:var(--text-color-hint);flex-shrink:0;font-size:26rpx;width:80rpx}.info-value{color:var(--text-color);flex:1;font-size:26rpx;word-break:break-all}.budget-value{color:var(--primary-color);font-weight:600}.note-text{color:var(--text-color-secondary)}.card-footer{border-top:2rpx solid var(--border-color);display:flex;justify-content:flex-end;padding-top:20rpx}.close-btn{background:var(--bg-color);border:2rpx solid var(--border-color);border-radius:28rpx;color:var(--text-color-secondary);font-size:26rpx;padding:12rpx 32rpx}.close-btn.loading{opacity:.6}.list-bottom{color:var(--text-color-hint);font-size:26rpx;padding:32rpx;text-align:center}