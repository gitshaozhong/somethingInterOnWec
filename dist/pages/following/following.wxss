.page-following {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 80rpx;
}

.page-header {
  padding: 32rpx;
  background: var(--white);
  border-bottom: 2rpx solid var(--border-color);
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-color);
}

.following-list {
  padding: 24rpx;
}

.following-card {
  background: var(--white);
  border-radius: var(--radius);
  margin-bottom: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.following-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.following-user {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.following-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.following-avatar-placeholder {
  background: var(--primary-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--primary-color);
}

.following-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.following-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.following-role {
  font-size: 24rpx;
  color: var(--text-color-hint);
}

.unfollow-btn {
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  background: var(--bg-color);
  color: var(--text-color-secondary);
  border: 2rpx solid var(--border-color);
}

.unfollow-btn.loading {
  opacity: 0.6;
}

.recent-posts {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--border-color);
}

.recent-title {
  font-size: 24rpx;
  color: var(--text-color-hint);
  margin-bottom: 16rpx;
  display: block;
}

.recent-post-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.post-info {
  display: flex;
  gap: 16rpx;
  flex: 1;
}

.post-date {
  font-size: 26rpx;
  color: var(--text-color);
  font-weight: 500;
}

.post-time {
  font-size: 26rpx;
  color: var(--text-color-secondary);
}

.post-venue {
  font-size: 24rpx;
  color: var(--text-color-hint);
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-arrow {
  font-size: 24rpx;
  color: var(--text-color-hint);
}

.no-posts {
  padding: 32rpx 0 16rpx;
  text-align: center;
}

.no-posts-text {
  font-size: 26rpx;
  color: var(--text-color-hint);
}

.empty {
  text-align: center;
  padding: 160rpx 0;
  color: var(--text-color-hint);
}
