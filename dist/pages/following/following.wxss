.page-following{background:var(--bg-color);min-height:100vh;padding-bottom:80rpx}.page-header{background:var(--white);border-bottom:2rpx solid var(--border-color);padding:32rpx}.page-title{color:var(--text-color);font-size:36rpx;font-weight:700}.following-list{padding:24rpx}.following-card{background:var(--white);border-radius:var(--radius);box-shadow:0 2rpx 8rpx rgba(0,0,0,.06);margin-bottom:24rpx;padding:32rpx}.following-header{align-items:center;display:flex;justify-content:space-between}.following-user{align-items:center;display:flex;flex:1;gap:24rpx}.following-avatar{border-radius:50%;flex-shrink:0;height:88rpx;width:88rpx}.following-avatar-placeholder{align-items:center;background:var(--primary-color-light);color:var(--primary-color);display:flex;font-size:36rpx;justify-content:center}.following-meta{display:flex;flex-direction:column;gap:4rpx}.following-name{color:var(--text-color);font-size:32rpx;font-weight:600}.following-role{color:var(--text-color-hint);font-size:24rpx}.unfollow-btn{background:var(--bg-color);border:2rpx solid var(--border-color);border-radius:28rpx;color:var(--text-color-secondary);font-size:24rpx;padding:12rpx 28rpx}.unfollow-btn.loading{opacity:.6}.recent-posts{border-top:2rpx solid var(--border-color);margin-top:24rpx;padding-top:24rpx}.recent-title{color:var(--text-color-hint);display:block;font-size:24rpx;margin-bottom:16rpx}.recent-post-item{align-items:center;background:var(--bg-color);border-radius:12rpx;display:flex;gap:16rpx;margin-bottom:12rpx;padding:16rpx 20rpx}.post-info{display:flex;flex:1;gap:16rpx}.post-date{color:var(--text-color);font-size:26rpx;font-weight:500}.post-time{color:var(--text-color-secondary);font-size:26rpx}.post-venue{color:var(--text-color-hint);font-size:24rpx;max-width:240rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.post-arrow{color:var(--text-color-hint);font-size:24rpx}.no-posts{padding:32rpx 0 16rpx;text-align:center}.no-posts-text{color:var(--text-color-hint);font-size:26rpx}.empty{color:var(--text-color-hint);padding:160rpx 0;text-align:center}