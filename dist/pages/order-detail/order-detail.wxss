@charset "UTF-8";
.page-detail {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 80rpx;
}

.detail-card {
  background: var(--white);
  margin: 24rpx;
  border-radius: var(--radius);
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 订单状态头部 */
.order-status-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-status-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.order-no {
  font-size: 24rpx;
  color: var(--text-color-hint);
  font-family: monospace;
}

/* 对方信息 */
.peer-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.peer-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.peer-avatar-placeholder {
  background: var(--primary-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--primary-color);
}

.peer-meta {
  flex: 1;
}

.peer-name {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.peer-role {
  font-size: 24rpx;
  color: var(--text-color-hint);
}

.peer-phone {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--border-color);
}

.phone-label {
  font-size: 26rpx;
  color: var(--text-color-hint);
}

.phone-value {
  font-size: 30rpx;
  color: var(--primary-color);
  font-weight: 600;
}

/* 联系方式撤回 */
.peer-phone-retracted {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--border-color);
}

.phone-retracted-text {
  font-size: 26rpx;
  color: var(--text-color-hint);
}

/* 订单信息 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  display: block;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 50%;
  margin-bottom: 20rpx;
}

.info-label {
  font-size: 24rpx;
  color: var(--text-color-hint);
  display: block;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 28rpx;
  color: var(--text-color);
  font-weight: 500;
}

/* 确认状态 */
.confirm-status {
  margin-bottom: 24rpx;
}

.confirm-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.confirm-icon {
  font-size: 36rpx;
  color: var(--text-color-hint);
}

.confirm-icon.done {
  color: var(--success-color);
}

.confirm-text {
  font-size: 26rpx;
  color: var(--text-color-secondary);
}

/* 按钮 */
.action-btn {
  width: 100%;
  height: 84rpx;
  border-radius: 42rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}

.action-btn.secondary {
  background: var(--bg-color);
  color: var(--text-color-secondary);
  border: 2rpx solid var(--border-color);
}

.wait-hint {
  display: block;
  font-size: 26rpx;
  color: var(--text-color-hint);
  margin-top: 16rpx;
  text-align: center;
}

.success-hint {
  display: block;
  font-size: 26rpx;
  color: var(--success-color);
  margin-top: 16rpx;
  text-align: center;
}

.peer-review-hint {
  display: block;
  font-size: 24rpx;
  color: var(--text-color-hint);
  margin-top: 8rpx;
  text-align: center;
}

/* 打卡 */
.checkin-hint {
  font-size: 26rpx;
  color: var(--text-color-secondary);
  margin-bottom: 16rpx;
  display: block;
  line-height: 1.5;
}

.checkin-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.checkin-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.checkin-badge {
  padding: 8rpx 32rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.checkin-badge.valid {
  background: #f6ffed;
  color: var(--success-color);
}

.checkin-badge.invalid {
  background: #fff2f0;
  color: var(--danger-color);
}

.checkin-photo {
  width: 400rpx;
  height: 300rpx;
  border-radius: 16rpx;
  -o-object-fit: cover;
     object-fit: cover;
}

.checkin-warn {
  font-size: 24rpx;
  color: var(--danger-color);
  line-height: 1.5;
  text-align: left;
  padding: 16rpx 20rpx;
  background: #fff2f0;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  display: block;
}

/* 打卡照片组合 */
.checkin-photos {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.checkin-photo-block {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
  flex: 1;
  min-width: 280rpx;
  max-width: 320rpx;
}

.checkin-photo-block .checkin-photo {
  width: 100%;
  height: 220rpx;
}

.checkin-photo-label {
  font-size: 24rpx;
  color: var(--text-color-secondary);
  margin-top: 8rpx;
  font-weight: 500;
}

.checkin-photo-time {
  font-size: 22rpx;
  color: var(--text-color-hint);
}

.checkin-photo-gps {
  font-size: 22rpx;
  color: var(--text-color-hint);
}

/* 时间线 */
.timeline {
  display: flex;
  flex-direction: column;
}

.timeline-node {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
}

.timeline-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 36rpx;
}

.timeline-icon {
  font-size: 32rpx;
  color: var(--text-color-hint);
  line-height: 1;
  width: 36rpx;
  text-align: center;
}

.timeline-node.done .timeline-icon {
  color: var(--success-color);
  font-weight: 700;
}

.timeline-line {
  flex: 1;
  width: 2rpx;
  min-height: 36rpx;
  background: var(--border-color);
  margin: 4rpx 0;
}

.timeline-node.done .timeline-line {
  background: var(--success-color);
}

.timeline-content {
  display: flex;
  flex-direction: column;
  padding-bottom: 24rpx;
  flex: 1;
}

.timeline-node:last-child .timeline-content {
  padding-bottom: 0;
}

.timeline-label {
  font-size: 26rpx;
  color: var(--text-color);
  font-weight: 500;
  line-height: 1.4;
}

.timeline-time {
  font-size: 22rpx;
  color: var(--text-color-hint);
  margin-top: 4rpx;
}

.timeline-time.pending {
  color: var(--text-color-hint);
}

/* 评价 */
.review-stars {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin: 24rpx 0;
}

.review-star {
  font-size: 72rpx;
  color: #e8e8e8;
}

.review-star.active {
  color: #faad14;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  width: 85%;
  max-width: 720rpx;
  background: var(--white);
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-color-hint);
  border-radius: 50%;
}

.modal-body {
  padding: 32rpx;
}

.modal-hint {
  font-size: 26rpx;
  color: var(--text-color-secondary);
  margin-bottom: 24rpx;
  display: block;
}

.photo-area {
  width: 100%;
  height: 300rpx;
  border: 4rpx dashed var(--border-color);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.photo-placeholder {
  font-size: 28rpx;
  color: var(--text-color-hint);
}

.photo-preview {
  width: 100%;
  height: 100%;
  -o-object-fit: cover;
     object-fit: cover;
}

.gps-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.gps-label {
  font-size: 26rpx;
  color: var(--text-color-hint);
}

.gps-value {
  font-size: 26rpx;
  color: var(--success-color);
}

.gps-value.gps-waiting {
  color: var(--text-color-hint);
}

.modal-textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  font-size: 28rpx;
  background: var(--bg-color);
  box-sizing: border-box;
  margin-top: 24rpx;
}

.modal-disclaimer {
  font-size: 22rpx;
  color: var(--text-color-hint);
  margin-top: 16rpx;
  display: block;
  text-align: center;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid var(--border-color);
}

.modal-cancel {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--bg-color);
  color: var(--text-color-secondary);
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-confirm {
  flex: 2;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: var(--text-color-hint);
}
