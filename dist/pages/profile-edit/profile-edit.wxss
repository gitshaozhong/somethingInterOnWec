.page-profile-edit{background:var(--bg-color);min-height:100vh;padding-bottom:160rpx}.page-header{background:var(--white);border-bottom:2rpx solid var(--border-color);padding:32rpx}.page-title{color:var(--text-color);font-size:36rpx;font-weight:700}.form-card{background:var(--white);border-radius:var(--radius);box-shadow:0 2rpx 8rpx rgba(0,0,0,.06);margin:24rpx;padding:32rpx}.avatar-section{border-bottom:2rpx solid var(--border-color);display:flex;gap:32rpx;margin-bottom:32rpx;padding-bottom:32rpx}.avatar-item{align-items:center;display:flex;flex:1;flex-direction:column;gap:12rpx}.avatar-label-row{align-items:center;display:flex;gap:12rpx}.avatar-label{color:var(--text-color);font-size:26rpx;font-weight:500}.uploading-text{color:var(--primary-color);font-size:22rpx}.avatar-preview{border:4rpx solid var(--border-color);border-radius:50%;height:144rpx;width:144rpx}.avatar-placeholder{align-items:center;background:var(--bg-color);color:var(--text-color-hint);display:flex;font-size:24rpx;justify-content:center}.avatar-hint{color:var(--text-color-hint);font-size:20rpx;line-height:1.4;text-align:center}.verify-status{border-radius:16rpx;font-size:22rpx;padding:2rpx 16rpx}.verify-status.status-verified{background:#f6ffed;color:var(--success-color)}.verify-status.status-pending{background:#fffbe6;color:var(--warning-color)}.verify-status.status-rejected{background:#fff2f0;color:var(--danger-color)}.section-title{border-bottom:2rpx solid var(--border-color);color:var(--text-color);font-size:30rpx;font-weight:600;margin-bottom:16rpx;padding:16rpx 0}.form-item{margin-bottom:32rpx}.form-label{color:var(--text-color);display:block;font-size:28rpx;font-weight:500;margin-bottom:8rpx}.form-hint{color:var(--text-color-hint);display:block;font-size:22rpx;line-height:1.4;margin-bottom:12rpx}.form-input{background:var(--white);border:2rpx solid var(--border-color);border-radius:12rpx;box-sizing:border-box;font-size:28rpx;height:80rpx;padding:0 24rpx;width:100%}.form-input.readonly{background:var(--bg-color);color:var(--text-color-hint)}.form-textarea{background:var(--white);border:2rpx solid var(--border-color);border-radius:12rpx;box-sizing:border-box;font-size:28rpx;height:160rpx;line-height:1.5;padding:20rpx;width:100%}.char-count{color:var(--text-color-hint);display:block;font-size:22rpx;margin-top:4rpx;text-align:right}.picker-value{align-items:center;border:2rpx solid var(--border-color);border-radius:12rpx;color:var(--text-color);display:flex;font-size:28rpx;height:80rpx;padding:0 24rpx}.tag-input-row{display:flex;gap:16rpx}.tag-input{flex:1}.add-tag-btn{align-items:center;background:var(--primary-color);border-radius:12rpx;color:#fff;display:flex;flex-shrink:0;font-size:26rpx;height:80rpx;justify-content:center;padding:0 32rpx}.tag-list{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:16rpx}.tag-item{background:var(--bg-color);border:2rpx solid var(--border-color);border-radius:28rpx;color:var(--text-color-secondary);font-size:24rpx;padding:8rpx 24rpx}.tag-item.active{background:var(--primary-color-light);border-color:var(--primary-color);color:var(--primary-color)}.submit-area{padding:24rpx}.submit-btn{align-items:center;background:var(--primary-color);border:none;border-radius:44rpx;color:#fff;display:flex;font-size:32rpx;font-weight:600;height:88rpx;justify-content:center;width:100%}.empty{color:var(--text-color-hint);padding:160rpx 0;text-align:center}