@charset "UTF-8";
.page-confirm {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-color);
}

.confirm-scroll {
  flex: 1;
  height: 0;
  box-sizing: border-box;
}

.list {
  padding: 24rpx;
}

.msg-card {
  background: var(--white);
  border-radius: var(--radius);
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.msg-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.msg-user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.msg-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.msg-avatar-placeholder {
  background: var(--primary-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--primary-color);
}

.msg-user-name {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}

.msg-order-no {
  font-size: 22rpx;
  color: var(--text-color-hint);
  font-family: monospace;
  display: block;
}

.msg-body {
  margin-bottom: 16rpx;
}

.msg-text-box {
  background: var(--bg-color);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.msg-text-label {
  font-size: 22rpx;
  color: var(--text-color-hint);
  display: block;
  margin-bottom: 4rpx;
}

.msg-text {
  font-size: 26rpx;
  color: var(--text-color);
  display: block;
}

.msg-reply-box {
  background: var(--primary-color-light);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.msg-reply-label {
  font-size: 22rpx;
  color: var(--primary-color);
  display: block;
  margin-bottom: 4rpx;
}

.msg-reply {
  font-size: 26rpx;
  color: var(--text-color);
  display: block;
}

.msg-source {
  font-size: 26rpx;
  color: var(--text-color-secondary);
  display: block;
}

.msg-phone-box {
  background: var(--primary-color-light);
  border: 2rpx solid var(--primary-color);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.msg-phone-label {
  font-size: 22rpx;
  color: var(--primary-color);
  display: block;
  margin-bottom: 4rpx;
}

.msg-phone {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 600;
  font-family: monospace;
}

.msg-real-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-top: 12rpx;
  border: 2rpx solid var(--primary-color);
}

.msg-phone-revoked {
  background: var(--bg-color);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: var(--text-color-hint);
}

.msg-time-row {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.msg-time {
  font-size: 22rpx;
  color: var(--text-color-hint);
}

.msg-waiting {
  font-size: 24rpx;
  color: var(--text-color-hint);
}

.msg-hint {
  font-size: 24rpx;
  color: var(--text-color-hint);
}

.msg-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.respond-btns {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-wrap: wrap;
}

.respond-btn {
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.respond-btn.accept {
  background: var(--primary-color);
  color: #fff;
}

.respond-btn.decline {
  background: var(--bg-color);
  color: var(--text-color-secondary);
  border: 2rpx solid var(--border-color);
}

.respond-btn.revoke {
  background: var(--bg-color);
  color: var(--danger-color);
  border: 2rpx solid var(--border-color);
}

.respond-btn.cancel {
  background: var(--bg-color);
  color: var(--text-color-secondary);
  border: 2rpx solid var(--border-color);
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  width: 85%;
  max-width: 720rpx;
  background: var(--white);
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-color-hint);
  border-radius: 50%;
}

.modal-body {
  padding: 32rpx;
}

.modal-hint {
  font-size: 26rpx;
  color: var(--text-color-secondary);
  margin-bottom: 24rpx;
  display: block;
}

.modal-textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  font-size: 28rpx;
  background: var(--bg-color);
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-color-hint);
  margin-top: 8rpx;
  display: block;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid var(--border-color);
}

.modal-cancel {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--bg-color);
  color: var(--text-color-secondary);
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-confirm {
  flex: 2;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-confirm.decline {
  background: var(--danger-color);
}

.safe-bottom {
  height: calc(48rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}
