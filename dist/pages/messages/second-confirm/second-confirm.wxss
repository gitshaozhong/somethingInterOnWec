.page-confirm{background:var(--bg-color);display:flex;flex-direction:column;height:100vh}.confirm-scroll{box-sizing:border-box;flex:1;height:0}.list{padding:24rpx}.msg-card{background:var(--white);border-radius:var(--radius);box-shadow:0 2rpx 6rpx rgba(0,0,0,.05);margin-bottom:20rpx;padding:28rpx 32rpx}.msg-header{align-items:center;display:flex;justify-content:space-between;margin-bottom:16rpx}.msg-user-info{align-items:center;display:flex;flex:1;gap:20rpx}.msg-avatar{border-radius:50%;flex-shrink:0;height:80rpx;width:80rpx}.msg-avatar-placeholder{align-items:center;background:var(--primary-color-light);color:var(--primary-color);display:flex;font-size:32rpx;justify-content:center}.msg-user-name{display:block;font-size:30rpx;font-weight:600}.msg-order-no{color:var(--text-color-hint);display:block;font-family:monospace;font-size:22rpx}.msg-source{color:var(--text-color-secondary);display:block;font-size:26rpx}.msg-badge-warn{background:#fef3c7;border-radius:20rpx;color:#92400e;font-size:22rpx;font-weight:500;padding:4rpx 16rpx}.msg-phone-box{background:var(--primary-color-light);border:2rpx solid var(--primary-color);border-radius:12rpx;margin-bottom:12rpx;padding:16rpx 20rpx}.msg-phone-label{color:var(--primary-color);display:block;font-size:22rpx;margin-bottom:4rpx}.msg-phone{color:var(--primary-color);font-family:monospace;font-size:28rpx;font-weight:600}.msg-confirm-status{display:flex;gap:16rpx;margin-bottom:12rpx}.confirm-tag{background:var(--bg-color);border-radius:8rpx;color:var(--text-color-hint);font-size:22rpx;padding:4rpx 16rpx}.confirm-tag.done{background:var(--primary-color-light);color:var(--primary-color)}.msg-time-row{display:flex;flex-wrap:wrap;gap:24rpx;margin-bottom:12rpx}.msg-time{color:var(--text-color-hint);font-size:22rpx}.msg-hint{color:var(--text-color-hint);font-size:24rpx}.msg-footer{align-items:center;display:flex;justify-content:space-between}.respond-btns{align-items:center;display:flex;flex-wrap:wrap;gap:12rpx}.respond-btn{border-radius:28rpx;font-size:24rpx;font-weight:500;padding:8rpx 24rpx}.respond-btn.accept{background:var(--primary-color);color:#fff}.safe-bottom{flex-shrink:0;height:calc(48rpx + env(safe-area-inset-bottom))}