@charset "UTF-8";
.page-messages {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #AEECEB 0%, #F8D2E1 100%);
}

/* ============ 未登录空状态 ============ */
.login-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 240rpx 64rpx;
}
.login-empty .login-empty-icon {
  font-size: 128rpx;
  margin-bottom: 32rpx;
}
.login-empty .login-empty-text {
  font-size: 28rpx;
  color: var(--text-color-hint);
  margin-bottom: 48rpx;
}

.login-btn {
  background: var(--primary-gradient);
  color: var(--white);
  border: none;
  border-radius: 48rpx;
  padding: 20rpx 80rpx;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(255, 106, 0, 0.3);
}

/* ============ 自定义导航栏样式由公共组件 CustomNav.scss 提供 ============ */
/* ============ 滚动容器 ============ */
.messages-scroll {
  flex: 1;
  height: 0;
  box-sizing: border-box;
}

/* ============ 浅橘色公告条 ============ */
.announce-bar {
  display: flex;
  align-items: center;
  background: #fff4e5;
  padding: 20rpx 28rpx;
  margin: 20rpx 24rpx 0;
  border-radius: 20rpx;
  gap: 16rpx;
}

.announce-text {
  flex: 1;
  font-size: 24rpx;
  color: #9a5a1a;
  line-height: 1.4;
}

.announce-btn {
  flex-shrink: 0;
  background: var(--primary-color);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
}

.announce-btn-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

.announce-close {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(154, 90, 26, 0.12);
}

.announce-close-icon {
  font-size: 22rpx;
  color: #9a5a1a;
  line-height: 1;
}

/* ============ 两个分类卡片 ============ */
.category-cards {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
}

.category-card {
  flex: 1;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-height: 192rpx;
  box-sizing: border-box;
}

.category-card.first {
  background: #fff8d6;
}

.category-card.second {
  background: #d8f5e0;
}

.category-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.category-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
  flex: 1;
  line-height: 1.3;
}

.category-card-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: var(--danger-color);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.category-card-badge-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
  line-height: 1;
}

.category-card-preview {
  font-size: 22rpx;
  color: var(--text-color-secondary);
  line-height: 1.5;
  word-break: break-all;
}

/* ============ 通用消息列表 ============ */
.section-list {
  background: var(--white);
  margin: 20rpx 24rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  padding: 0 28rpx;
}

/* ============ 消息条目 ============ */
.msg-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  gap: 24rpx;
  border-bottom: 2rpx solid var(--divider-color);
}

.msg-row:last-child {
  border-bottom: none;
}

.msg-row-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.msg-row-avatar.system {
  background: #d6f5e0;
}

.msg-row-avatar.ad {
  background: #fff0e5;
}

.msg-row-avatar-icon {
  font-size: 40rpx;
  line-height: 1;
}

.msg-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.msg-row-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.msg-row-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-row-badge {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--danger-color);
  flex-shrink: 0;
}

.msg-row-preview {
  font-size: 24rpx;
  color: var(--text-color-hint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-row-meta {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.msg-row-time {
  font-size: 22rpx;
  color: var(--text-color-hint);
}

.msg-row-unread-num {
  font-size: 20rpx;
  color: #fff;
  background: var(--danger-color);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  line-height: 1.4;
}

/* ============ 分区标题 ============ */
.section-divider {
  padding: 32rpx 48rpx 16rpx;
}

.section-divider-text {
  font-size: 24rpx;
  color: var(--text-color-hint);
}

/* ============ 安全底部 ============ */
.safe-bottom {
  height: calc(48rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}
