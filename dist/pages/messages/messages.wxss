.page-messages{background:linear-gradient(180deg,#aeeceb,#f8d2e1);display:flex;flex-direction:column;height:100vh}.login-empty{align-items:center;display:flex;flex-direction:column;padding:240rpx 64rpx}.login-empty .login-empty-icon{font-size:128rpx;margin-bottom:32rpx}.login-empty .login-empty-text{color:var(--text-color-hint);font-size:28rpx;margin-bottom:48rpx}.login-btn{background:var(--primary-gradient);border:none;border-radius:48rpx;box-shadow:0 8rpx 24rpx rgba(255,106,0,.3);color:var(--white);font-size:30rpx;font-weight:500;padding:20rpx 80rpx}.messages-scroll{box-sizing:border-box;flex:1;height:0}.announce-bar{align-items:center;background:#fff4e5;border-radius:20rpx;display:flex;gap:16rpx;margin:20rpx 24rpx 0;padding:20rpx 28rpx}.announce-text{color:#9a5a1a;flex:1;font-size:24rpx;line-height:1.4}.announce-btn{background:var(--primary-color);border-radius:24rpx;flex-shrink:0;padding:8rpx 24rpx}.announce-btn-text{color:#fff;font-size:24rpx;font-weight:500}.announce-close{align-items:center;background:rgba(154,90,26,.12);border-radius:50%;display:flex;flex-shrink:0;height:40rpx;justify-content:center;width:40rpx}.announce-close-icon{color:#9a5a1a;font-size:22rpx;line-height:1}.category-cards{display:flex;gap:20rpx;padding:24rpx}.category-card{border-radius:28rpx;box-shadow:0 4rpx 12rpx rgba(0,0,0,.04);box-sizing:border-box;display:flex;flex:1;flex-direction:column;gap:12rpx;min-height:192rpx;padding:28rpx 24rpx}.category-card.first{background:#fff8d6}.category-card.second{background:#d8f5e0}.category-card-header{align-items:center;display:flex;gap:12rpx;justify-content:space-between}.category-card-title{color:var(--text-color);flex:1;font-size:28rpx;font-weight:600;line-height:1.3}.category-card-badge{align-items:center;background:var(--danger-color);border-radius:18rpx;display:flex;flex-shrink:0;height:36rpx;justify-content:center;min-width:36rpx;padding:0 10rpx}.category-card-badge-text{color:#fff;font-size:22rpx;font-weight:600;line-height:1}.category-card-preview{color:var(--text-color-secondary);font-size:22rpx;line-height:1.5;word-break:break-all}.section-list{background:var(--white);border-radius:24rpx;margin:20rpx 24rpx 0;overflow:hidden;padding:0 28rpx}.msg-row{align-items:center;border-bottom:2rpx solid var(--divider-color);display:flex;gap:24rpx;padding:28rpx 0}.msg-row:last-child{border-bottom:none}.msg-row-avatar{align-items:center;border-radius:20rpx;display:flex;flex-shrink:0;height:80rpx;justify-content:center;width:80rpx}.msg-row-avatar.system{background:#d6f5e0}.msg-row-avatar.ad{background:#fff0e5}.msg-row-avatar-icon{font-size:40rpx;line-height:1}.msg-row-main{display:flex;flex:1;flex-direction:column;gap:6rpx;min-width:0}.msg-row-title-row{align-items:center;display:flex;gap:12rpx}.msg-row-title{color:var(--text-color);flex:1;font-size:28rpx;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.msg-row-badge{background:var(--danger-color);border-radius:50%;flex-shrink:0;height:16rpx;width:16rpx}.msg-row-preview{color:var(--text-color-hint);font-size:24rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.msg-row-meta{align-items:flex-end;display:flex;flex-direction:column;flex-shrink:0;gap:8rpx}.msg-row-time{color:var(--text-color-hint);font-size:22rpx}.msg-row-unread-num{background:var(--danger-color);border-radius:16rpx;color:#fff;font-size:20rpx;line-height:1.4;padding:2rpx 12rpx}.section-divider{padding:32rpx 48rpx 16rpx}.section-divider-text{color:var(--text-color-hint);font-size:24rpx}.safe-bottom{flex-shrink:0;height:calc(48rpx + env(safe-area-inset-bottom))}