.page-messages{background:var(--bg-color);display:flex;flex-direction:column;height:100vh}.tab-bar{background:var(--white);border-bottom:2rpx solid var(--border-color);display:flex;padding:24rpx 32rpx}.tab-item{border-bottom:4rpx solid transparent;color:var(--text-color-secondary);flex:1;font-size:30rpx;padding:16rpx 0;text-align:center}.tab-item.active{border-bottom-color:var(--primary-color);color:var(--primary-color);font-weight:600}.list{flex:1;overflow-y:auto;padding:24rpx}.msg-card{background:var(--white);border-radius:var(--radius);box-shadow:0 2rpx 6rpx rgba(0,0,0,.05);margin-bottom:20rpx;padding:28rpx 32rpx}.msg-header{align-items:center;display:flex;justify-content:space-between;margin-bottom:16rpx}.msg-user-info{align-items:center;display:flex;flex:1;gap:20rpx}.msg-avatar{border-radius:50%;flex-shrink:0;height:80rpx;width:80rpx}.msg-avatar-placeholder{align-items:center;background:var(--primary-color-light);color:var(--primary-color);display:flex;font-size:32rpx;justify-content:center}.msg-user-name{display:block;font-size:30rpx;font-weight:600}.msg-order-no{color:var(--text-color-hint);display:block;font-family:monospace;font-size:22rpx}.msg-body{margin-bottom:16rpx}.msg-source{color:var(--text-color-secondary);display:block;font-size:26rpx}.msg-text{background:var(--bg-color);border-radius:8rpx;color:var(--text-color);display:block;font-size:26rpx;margin-top:8rpx;padding:12rpx 20rpx}.msg-reply{background:var(--primary-color-light);border-radius:8rpx;color:var(--primary-color);display:block;font-size:26rpx;margin-top:8rpx;padding:12rpx 20rpx}.msg-footer{align-items:center;display:flex;justify-content:space-between}.msg-time{color:var(--text-color-hint);font-size:24rpx}.msg-phone{color:var(--primary-color);font-size:26rpx;font-weight:600}.msg-actions{align-items:center;display:flex;gap:16rpx;margin-left:auto}.respond-btns{display:flex;gap:12rpx}.respond-btn{border-radius:28rpx;font-size:24rpx;font-weight:500;padding:8rpx 24rpx}.respond-btn.accept{background:var(--primary-color);color:#fff}.respond-btn.decline{background:var(--bg-color);border:2rpx solid var(--border-color);color:var(--text-color-secondary)}.modal-overlay{align-items:center;background:rgba(0,0,0,.5);bottom:0;display:flex;justify-content:center;left:0;position:fixed;right:0;top:0;z-index:100}.modal-content{background:var(--white);border-radius:24rpx;max-width:720rpx;overflow:hidden;width:85%}.modal-header{align-items:center;border-bottom:2rpx solid var(--border-color);display:flex;justify-content:space-between;padding:32rpx}.modal-title{font-size:32rpx;font-weight:600}.modal-close{align-items:center;border-radius:50%;color:var(--text-color-hint);display:flex;font-size:32rpx;height:56rpx;justify-content:center;width:56rpx}.modal-body{padding:32rpx}.modal-hint{color:var(--text-color-secondary);display:block;font-size:26rpx;margin-bottom:24rpx}.modal-textarea{background:var(--bg-color);border:2rpx solid var(--border-color);border-radius:16rpx;box-sizing:border-box;font-size:28rpx;height:160rpx;padding:20rpx;width:100%}.char-count{color:var(--text-color-hint);display:block;font-size:22rpx;margin-top:8rpx;text-align:right}.modal-footer{border-top:2rpx solid var(--border-color);display:flex;gap:24rpx;padding:24rpx 32rpx}.modal-cancel{align-items:center;background:var(--bg-color);border:none;border-radius:40rpx;color:var(--text-color-secondary);display:flex;flex:1;font-size:28rpx;height:80rpx;justify-content:center}.modal-confirm{align-items:center;background:var(--primary-color);border:none;border-radius:40rpx;color:#fff;display:flex;flex:2;font-size:28rpx;font-weight:600;height:80rpx;justify-content:center}.modal-confirm.decline{background:var(--danger-color)}