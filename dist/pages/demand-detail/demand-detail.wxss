.page-detail{background:var(--bg-color);min-height:100vh;padding-bottom:200rpx}.detail-card{background:var(--white);border-radius:var(--radius);box-shadow:0 2rpx 8rpx rgba(0,0,0,.06);margin:24rpx;padding:32rpx}.user-header .user-info{align-items:flex-start;display:flex;gap:24rpx}.user-avatar{border-radius:50%;flex-shrink:0;height:112rpx;width:112rpx}.user-avatar-placeholder{align-items:center;background:var(--primary-color-light);color:var(--primary-color);display:flex;font-size:44rpx;justify-content:center}.user-meta{flex:1}.user-name-row{align-items:center;display:flex;gap:16rpx}.user-name{font-size:36rpx;font-weight:700}.follow-btn{background:var(--primary-color);border-radius:24rpx;color:#fff;font-size:24rpx;padding:6rpx 20rpx}.follow-btn.following{background:var(--bg-color);color:var(--text-color-secondary)}.user-tags{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:12rpx}.tag{background:var(--bg-color);border-radius:8rpx;color:var(--text-color-secondary);font-size:22rpx;padding:4rpx 16rpx}.rating-row{align-items:center;display:flex;gap:8rpx;margin-top:8rpx}.rating-score{color:#faad14;font-size:24rpx;font-weight:600}.rating-count{color:var(--text-color-hint);font-size:22rpx}.review-hint{color:var(--text-color-hint);display:block;font-size:22rpx;margin-top:8rpx}.user-bio{border-top:2rpx solid var(--border-color);margin-top:24rpx;padding-top:24rpx}.bio-label{color:var(--text-color-hint);display:block;font-size:24rpx;margin-bottom:8rpx}.bio-text{color:var(--text-color);font-size:28rpx;line-height:1.6;white-space:pre-wrap}.goal-tags-section{border-top:2rpx solid var(--border-color);margin-top:24rpx;padding-top:24rpx}.goal-tags{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:8rpx}.goal-tag{background:#f6ffed;border:2rpx solid #b7eb8f;border-radius:24rpx;color:var(--success-color);font-size:24rpx;padding:6rpx 20rpx}.section-header{align-items:center;display:flex;justify-content:space-between;margin-bottom:24rpx}.section-title{font-size:32rpx;font-weight:600}.status-badge{border-radius:24rpx;font-size:24rpx;padding:6rpx 20rpx}.status-open{background:#f6ffed;color:var(--success-color)}.status-closed,.status-expired,.status-filled{background:var(--bg-color);color:var(--text-color-hint)}.info-grid{display:flex;flex-wrap:wrap}.info-item{margin-bottom:24rpx;width:50%}.info-item-full{width:100%}.info-label{color:var(--text-color-hint);display:block;font-size:24rpx;margin-bottom:4rpx}.info-value{color:var(--text-color);font-size:28rpx;font-weight:500}.info-value.price{color:var(--primary-color);font-weight:600}.note-box{background:var(--bg-color);border-radius:12rpx;margin-top:16rpx;padding:20rpx}.note-label{color:var(--text-color-hint);display:block;font-size:22rpx;margin-bottom:8rpx}.note-text{color:var(--text-color);font-size:26rpx;line-height:1.5}.bottom-bar{background:var(--white);border-top:2rpx solid var(--border-color);bottom:0;left:0;padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));position:fixed;right:0;z-index:10}.contact-btn{align-items:center;background:var(--primary-color);border:none;border-radius:44rpx;color:#fff;display:flex;font-size:32rpx;font-weight:600;height:88rpx;justify-content:center;width:100%}.contact-btn.secondary{background:var(--bg-color);color:var(--text-color-secondary)}.login-hint{color:var(--text-color-hint);font-size:24rpx;padding:24rpx;text-align:center}.modal-overlay{align-items:center;background:rgba(0,0,0,.5);bottom:0;display:flex;justify-content:center;left:0;position:fixed;right:0;top:0;z-index:100}.modal-content{background:var(--white);border-radius:24rpx;max-width:720rpx;overflow:hidden;width:85%}.modal-header{align-items:center;border-bottom:2rpx solid var(--border-color);display:flex;justify-content:space-between;padding:32rpx}.modal-title{font-size:32rpx;font-weight:600}.modal-close{align-items:center;border-radius:50%;color:var(--text-color-hint);display:flex;font-size:32rpx;height:56rpx;justify-content:center;width:56rpx}.modal-body{padding:32rpx}.modal-hint{color:var(--text-color-secondary);display:block;font-size:26rpx;margin-bottom:24rpx}.modal-textarea{background:var(--bg-color);border:2rpx solid var(--border-color);border-radius:16rpx;box-sizing:border-box;font-size:28rpx;height:200rpx;padding:20rpx;width:100%}.char-count{color:var(--text-color-hint);display:block;font-size:22rpx;margin-top:8rpx;text-align:right}.modal-disclaimer{color:var(--text-color-hint);display:block;font-size:22rpx;margin-top:16rpx;text-align:center}.modal-footer{border-top:2rpx solid var(--border-color);display:flex;gap:24rpx;padding:24rpx 32rpx}.modal-cancel{align-items:center;background:var(--bg-color);border:none;border-radius:40rpx;color:var(--text-color-secondary);display:flex;flex:1;font-size:28rpx;height:80rpx;justify-content:center}.modal-confirm{align-items:center;background:var(--primary-color);border:none;border-radius:40rpx;color:#fff;display:flex;flex:2;font-size:28rpx;font-weight:600;height:80rpx;justify-content:center}.empty-state{color:var(--text-color-hint);padding:120rpx 0;text-align:center}