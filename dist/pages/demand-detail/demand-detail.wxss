@charset "UTF-8";
/* 需求详情页 —— 复用档期详情页样式 */
/* 主样式引用自 availability-detail/detail.scss */
.page-detail {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 200rpx;
}

.detail-card {
  background: var(--white);
  margin: 24rpx;
  border-radius: var(--radius);
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 学员信息 */
.user-header .user-info {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.user-avatar-placeholder {
  background: var(--primary-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--primary-color);
}

.user-meta {
  flex: 1;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
}

.follow-btn {
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  background: var(--primary-color);
  color: #fff;
}

.follow-btn.following {
  background: var(--bg-color);
  color: var(--text-color-secondary);
}

.user-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.tag {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: var(--bg-color);
  color: var(--text-color-secondary);
}

.rating-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.rating-score {
  font-size: 24rpx;
  color: #faad14;
  font-weight: 600;
}

.rating-count {
  font-size: 22rpx;
  color: var(--text-color-hint);
}

.review-hint {
  font-size: 22rpx;
  color: var(--text-color-hint);
  margin-top: 8rpx;
  display: block;
}

.user-bio {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--border-color);
}

.bio-label {
  font-size: 24rpx;
  color: var(--text-color-hint);
  margin-bottom: 8rpx;
  display: block;
}

.bio-text {
  font-size: 28rpx;
  color: var(--text-color);
  line-height: 1.6;
  white-space: pre-wrap;
}

.goal-tags-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--border-color);
}

.goal-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.goal-tag {
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  background: #f6ffed;
  color: var(--success-color);
  border: 2rpx solid #b7eb8f;
}

/* 档期信息 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
}

.status-badge {
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.status-open {
  background: #f6ffed;
  color: var(--success-color);
}

.status-closed, .status-expired, .status-filled {
  background: var(--bg-color);
  color: var(--text-color-hint);
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 50%;
  margin-bottom: 24rpx;
}

.info-item-full {
  width: 100%;
}

.info-label {
  font-size: 24rpx;
  color: var(--text-color-hint);
  display: block;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 28rpx;
  color: var(--text-color);
  font-weight: 500;
}

.info-value.price {
  color: var(--primary-color);
  font-weight: 600;
}

.note-box {
  background: var(--bg-color);
  padding: 20rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

.note-label {
  font-size: 22rpx;
  color: var(--text-color-hint);
  display: block;
  margin-bottom: 8rpx;
}

.note-text {
  font-size: 26rpx;
  color: var(--text-color);
  line-height: 1.5;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--white);
  border-top: 2rpx solid var(--border-color);
  z-index: 10;
}

.contact-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-btn.secondary {
  background: var(--bg-color);
  color: var(--text-color-secondary);
}

.login-hint {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: var(--text-color-hint);
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  width: 85%;
  max-width: 720rpx;
  background: var(--white);
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-color-hint);
  border-radius: 50%;
}

.modal-body {
  padding: 32rpx;
}

.modal-hint {
  font-size: 26rpx;
  color: var(--text-color-secondary);
  margin-bottom: 24rpx;
  display: block;
}

.modal-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  font-size: 28rpx;
  background: var(--bg-color);
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-color-hint);
  margin-top: 8rpx;
  display: block;
}

.modal-disclaimer {
  font-size: 22rpx;
  color: var(--text-color-hint);
  margin-top: 16rpx;
  display: block;
  text-align: center;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid var(--border-color);
}

.modal-cancel {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--bg-color);
  color: var(--text-color-secondary);
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-confirm {
  flex: 2;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: var(--text-color-hint);
}
