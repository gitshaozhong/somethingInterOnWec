.page-index{background:linear-gradient(180deg,#aeeceb,#f8d2e1);display:flex;flex-direction:column;height:100vh}.header-gradient{flex-shrink:0;padding:24rpx 24rpx 0}.sunk-tab-bar{background:hsla(0,0%,100%,.5);border-radius:24rpx 24rpx 0 0;display:flex;gap:4rpx;padding:6rpx}.sunk-tab{border-radius:20rpx 20rpx 0 0;color:#5a6a7a;flex:1;font-size:28rpx;padding:16rpx 0;text-align:center;transition:all .2s}.sunk-tab.active{background:var(--white);box-shadow:0 -4rpx 16rpx rgba(0,0,0,.04);color:#07b6d5;font-weight:600}.sunk-tab-text{line-height:1.2}.filter-entry-bar{align-items:center;background:var(--white);border-radius:0 0 24rpx 24rpx;box-shadow:var(--card-shadow);display:flex;gap:16rpx;padding:20rpx 24rpx}.entry-item{align-items:center;background:var(--chip-bg);border-radius:32rpx;color:var(--chip-color);display:flex;font-size:26rpx;gap:10rpx;padding:12rpx 32rpx;position:relative}.entry-item.active{background:var(--primary-color-light);color:var(--primary-color);font-weight:600}.entry-icon-filter{color:var(--text-color-secondary);font-size:26rpx}.entry-item.active .entry-icon-filter{color:var(--primary-color)}.entry-text{white-space:nowrap}.entry-icon{color:var(--text-color-hint);font-size:20rpx}.entry-item.active .entry-icon{color:var(--primary-color)}.entry-dot{background:var(--primary-color);border-radius:50%;height:12rpx;position:absolute;right:12rpx;top:8rpx;width:12rpx}.entry-clear{color:var(--text-color-hint);flex-shrink:0;font-size:24rpx;margin-left:auto;padding:8rpx 16rpx}.panel-mask{background:rgba(0,0,0,.4);bottom:0;left:0;position:fixed;right:0;top:0;z-index:100}.filter-panel-top{animation:slideDown .25s ease-out;background:var(--white);border-radius:0 0 32rpx 32rpx;box-shadow:0 8rpx 32rpx rgba(0,0,0,.12);display:flex;flex-direction:column;height:70vh;left:0;position:fixed;right:0;top:0;z-index:101}@keyframes slideDown{from{transform:translateY(-100%)}to{transform:translateY(0)}}.panel-handle{background:#e0e0e0;border-radius:6rpx;flex-shrink:0;height:10rpx;ma