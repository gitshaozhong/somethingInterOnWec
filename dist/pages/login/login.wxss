.page-login{align-items:center;background:var(--white);display:flex;justify-content:center;min-height:100vh}.login-content{padding:80rpx;text-align:center;width:100%}.logo-area{margin-bottom:96rpx}.app-name{color:var(--primary-color);display:block;font-size:56rpx;font-weight:700}.app-desc{color:var(--text-color-hint);display:block;font-size:28rpx;margin-top:16rpx}.wechat-login-btn{background:#07c160;border:none;border-radius:var(--radius);color:var(--white);font-size:32rpx;font-weight:600;margin:0 auto;max-width:600rpx;padding:28rpx;width:100%}.wechat-login-btn[disabled]{opacity:.6}.privacy-tip{color:var(--text-color-hint);display:block;font-size:24rpx;line-height:1.6;margin-top:40rpx;padding:0 48rpx}