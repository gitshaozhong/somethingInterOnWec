.page-login{align-items:center;background:var(--white);display:flex;justify-content:center;min-height:100vh}.login-content{padding:80rpx;text-align:center;width:100%}.logo-area{margin-bottom:96rpx}.app-name{color:var(--primary-color);display:block;font-size:56rpx;font-weight:700}.app-desc{color:var(--text-color-hint);display:block;font-size:28rpx;margin-top:16rpx}.role-select{margin-bottom:64rpx}.role-label{color:var(--text-color-secondary);display:block;font-size:30rpx;margin-bottom:32rpx}.role-options{display:flex;gap:24rpx;justify-content:center}.role-card{background:var(--white);border:4rpx solid var(--border-color);border-radius:var(--radius);padding:40rpx 24rpx;text-align:center;transition:border-color .2s;width:280rpx}.role-card.active{background:var(--primary-color-light);border-color:var(--primary-color)}.role-icon{display:block;font-size:64rpx;margin-bottom:16rpx}.role-name{color:var(--text-color);display:block;font-size:30rpx;font-weight:600}.role-desc{color:var(--text-color-hint);display:block;font-size:22rpx;margin-top:8rpx}.wechat-login-btn{background:#07c160;border:none;border-radius:var(--radius);color:var(--white);font-size:32rpx;font-weight:600;margin:0 auto;max-width:600rpx;padding:28rpx;width:100%}.wechat-login-btn[disabled]{opacity:.6}.privacy-tip{color:var(--text-color-hint);display:block;font-size:24rpx;margin-top:40rpx}