.page-login {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--white);
}

.login-content {
  text-align: center;
  padding: 80rpx;
  width: 100%;
}

.logo-area {
  margin-bottom: 96rpx;
}

.app-name {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--primary-color);
  display: block;
}

.app-desc {
  font-size: 28rpx;
  color: var(--text-color-hint);
  margin-top: 16rpx;
  display: block;
}

.wechat-login-btn {
  width: 100%;
  max-width: 600rpx;
  margin: 0 auto;
  background: #07c160;
  color: var(--white);
  border: none;
  border-radius: var(--radius);
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.wechat-login-btn[disabled] {
  opacity: 0.6;
}

.privacy-tip {
  font-size: 24rpx;
  color: var(--text-color-hint);
  margin-top: 40rpx;
  display: block;
  padding: 0 48rpx;
  line-height: 1.6;
}
