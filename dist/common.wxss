@charset "UTF-8";
/* ============ 自定义导航栏（4 个 Tab 页统一样式） ============ */
.custom-nav {
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(16rpx);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.4);
}

.custom-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.custom-nav-left {
  width: 160rpx;
  display: flex;
  align-items: center;
}

.custom-nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-color);
}

.custom-nav-right {
  width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.custom-nav-action {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 500;
}
