.custom-nav{backdrop-filter:blur(16rpx);background:hsla(0,0%,100%,.85);border-bottom:2rpx solid hsla(0,0%,100%,.4);flex-shrink:0}.custom-nav-inner{align-items:center;display:flex;height:88rpx;justify-content:space-between;padding:0 32rpx}.custom-nav-left{align-items:center;display:flex;width:160rpx}.custom-nav-title{color:var(--text-color);flex:1;font-size:34rpx;font-weight:600;text-align:center}.custom-nav-right{align-items:center;display:flex;justify-content:flex-end;width:160rpx}.custom-nav-action{color:var(--primary-color);font-size:28rpx;font-weight:500}