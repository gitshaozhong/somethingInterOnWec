page{--primary-color:#ff6a00;--primary-color-light:#fff0e5;--primary-gradient:linear-gradient(135deg,#ff6a00,#f96);--primary-gradient-vertical:linear-gradient(180deg,#ff6a00,#ff8a3d 60%,#f5f7fa);--secondary-color:#1677ff;--secondary-color-light:#e6f0ff;--success-color:#10b981;--success-gradient:linear-gradient(135deg,#10b981,#34d399);--warning-color:#f59e0b;--danger-color:#ef4444;--danger-gradient:linear-gradient(135deg,#ef4444,#f87171);--text-color:#1a1a1a;--text-color-secondary:#3d3d4e;--text-color-hint:#8a8a9a;--border-color:#eee;--bg-color:#f5f7fa;--card-bg:#fff;--chip-bg:#f0f1f5;--chip-color:#3d3d4e;--white:#fff;--radius:24rpx;--radius-lg:32rpx;--radius-xl:40rpx;--card-shadow:0 4rpx 16rpx rgba(0,0,0,.04);--card-shadow-hover:0 8rpx 32rpx rgba(0,0,0,.08);--divider-color:#f6f6f6;background-color:var(--bg-color);color:var(--text-color);font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica Neue,Arial,sans-serif;font-size:28rpx;line-height:1.5}.flex-center{align-items:center;display:flex;justify-content:center}.flex-between{align-items:center;display:flex;justify-content:space-between}.text-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.safe-bottom{padding-bottom:env(safe-area-inset-bottom)}