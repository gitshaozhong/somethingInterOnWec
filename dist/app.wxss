page{--primary-color:#10b981;--primary-color-light:#d1fae5;--success-color:#10b981;--warning-color:#f59e0b;--danger-color:#ef4444;--text-color:#18181b;--text-color-secondary:#52525b;--text-color-hint:#a1a1aa;--border-color:#e4e4e7;--bg-color:#f4f4f5;--white:#fff;--radius:24rpx;--radius-lg:32rpx;background-color:var(--bg-color);color:var(--text-color);font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica Neue,Arial,sans-serif;font-size:28rpx;line-height:1.5}.flex-center{align-items:center;display:flex;justify-content:center}.flex-between{align-items:center;display:flex;justify-content:space-between}.text-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.safe-bottom{padding-bottom:env(safe-area-inset-bottom)}