@charset "UTF-8";
.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: var(--white, #ffffff);
  border-top: 2rpx solid #f0f0f0;
  z-index: 999;
  /* 兼容 iPhone X 底部安全区 */
  padding-bottom: env(safe-area-inset-bottom);
}

.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom));
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 8rpx;
  gap: 4rpx;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-text {
  font-size: 20rpx;
  color: var(--text-color-hint, #8a8a9a);
  line-height: 1.2;
}

.tab-item.active .tab-text {
  color: var(--primary-color, #ff6a00);
  font-weight: 600;
}

/* 未读徽标 */
.tab-icon-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.tab-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: var(--danger-color, #ef4444);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #ffffff;
  box-sizing: content-box;
}

.tab-badge-text {
  font-size: 18rpx;
  color: #ffffff;
  font-weight: 600;
  line-height: 1;
}
