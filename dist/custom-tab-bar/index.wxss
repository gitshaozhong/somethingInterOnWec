.custom-tabbar{background:var(--white,#fff);border-top:2rpx solid #f0f0f0;bottom:0;display:flex;left:0;padding-bottom:env(safe-area-inset-bottom);position:fixed;right:0;z-index:999}.safe-bottom{padding-bottom:calc(env(safe-area-inset-bottom))}.tab-item{align-items:center;display:flex;flex:1;flex-direction:column;gap:4rpx;justify-content:center;padding:12rpx 0 8rpx}.tab-icon{height:48rpx;width:48rpx}.tab-text{color:var(--text-color-hint,#8a8a9a);font-size:20rpx;line-height:1.2}.tab-item.active .tab-text{color:var(--primary-color,#ff6a00);font-weight:600}.tab-icon-wrap{align-items:center;display:inline-flex;justify-content:center;position:relative}.tab-badge{align-items:center;background:var(--danger-color,#ef4444);border:3rpx solid #fff;border-radius:16rpx;box-sizing:content-box;display:flex;height:32rpx;justify-content:center;min-width:32rpx;padding:0 8rpx;position:absolute;right:-16rpx;top:-8rpx}.tab-badge-text{color:#fff;font-size:18rpx;font-weight:600;line-height:1}